    "```java\n",
    "public class BusquedaSecuencial {\n",
    "    //Se crea el metodo para buscar un numero en un arreglo\n",
    "    public static int buscar(int[] numeros, int objetivo) {\n",
    "\n",
    "        //Recorremos el arreglo por completo\n",
    "        for (int i = 0; i < numeros.length; i++) {\n",
    "\n",
    "            //Despues verificamos si el número actual es igual al objetivo\n",
    "            if (numeros[i] == objetivo) {\n",
    "\n",
    "                System.out.println(\"Número encontrado en la posición: \" + i);\n",
    "\n",
    "                //Una vez encontramos el numero, retornamos la posición donde se lo encontro\n",
    "                return i;\n",
    "            }\n",
    "        }\n",
    "\n",
    "        // Se utiliza un sout por si no encuentra el número para que termine el ciclo\n",
    "        System.out.println(\"Número no encontrado\");\n",
    "\n",
    "        return -1;\n",
    "    }\n",
    "}\n",
