    "def busqueda_binaria(datos, objetivo):\n",
    "    \"\"\"\n",
    "    Función para realizar una búsqueda binaria en una lista ordenada.\n",
    "    \n",
    "    :param datos: Una lista numérica o de caracteres ORDENADA.\n",
    "    :param objetivo: El valor que se desea encontrar.\n",
    "    :return: El índice del objetivo si se encuentra, de lo contrario, None.\n",
    "    \"\"\"\n",
    "    # Verificar que la lista no esté vacía\n",
    "    if not datos:\n",
    "        print(\"La lista está vacía.\")\n",
    "        return None\n",
    "\n",
    "    inicio = 0\n",
    "    fin = len(datos) - 1\n",
    "\n",
    "    while inicio <= fin:\n",
    "        # Calcular el punto medio usando división entera\n",
    "        medio = (inicio + fin) // 2\n",
    "\n",
    "        # Comparamos el elemento en el medio con el objetivo\n",
    "        if datos[medio] == objetivo:\n",
    "            print(f\"Objetivo {objetivo} encontrado en el índice {medio}\")\n",
    "            return medio  # ¡Encontrado!\n",
    "        elif datos[medio] < objetivo:\n",
    "            # El objetivo está en la mitad derecha\n",
    "            inicio = medio + 1\n",
    "        else:\n",
    "            # El objetivo está en la mitad izquierda\n",
